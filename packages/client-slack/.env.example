# Environment
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Slack app
# ---------------------------------------------------------------------------
# Required in socket mode (ENVIRONMENT=local). Basic Information -> App-Level
# Tokens -> Generate Token and Scopes, with the `connections:write` scope. This
# is NOT the bot token and is not on the OAuth & Permissions page.
SLACK_APP_TOKEN=xapp-your-app-token

# Bot credentials. Normally a workspace installs the app and its row lands in
# `bot_installations`; token routing then reads that table rather than the env.
# For local development, setting APP_ID + TEAM_ID + BOT_TOKEN *together* seeds
# that row at startup and skips the install flow (see slackApp.ts). Miss any one
# of the three and startup logs "skipping bot installation seed" and no bot works.
#   SLACK_APP_ID   — the A0... id on Basic Information
#   SLACK_TEAM_ID  — the workspace ("team") id, T...
#   SLACK_BOT_TOKEN — OAuth & Permissions -> Bot User OAuth Token (after install)
# `curl -H "Authorization: Bearer xoxb-..." https://slack.com/api/auth.test`
# returns team_id and app_id and confirms the token in one call.
SLACK_APP_ID=your-app-id
SLACK_TEAM_ID=your-team-id
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# Display name and slash command for the seeded installation. Optional; these are
# not overwritten on conflict, so admin edits survive a redeploy.
# SLACK_BOT_NAME=Nannos
# SLACK_SLASH_COMMAND=/nannos

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
BASE_URL=http://localhost:3000
SLACK_APP_PORT=3000
# Admin/v2 API port (default 3001)
# V2_APP_PORT=3001
LOG_LEVEL=debug
# Reported in health/diagnostics output (default "next")
# VERSION=next
# Idle keep-alive for outbound HTTP connections, ms (default 60000)
# HTTP_IDLE_CONNECTION_KEEP_ALIVE_TIMEOUT=60000
# Start the admin API without connecting to Slack. Useful when you have no app
# credentials yet.
# SKIP_SLACK=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=4700
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nannos
POSTGRES_USE_SSL=false
# POSTGRES_SSL_CA=/path/to/ca-cert.pem
# Schema holding this client's tables. sqlmigrations/migrate.sh defaults PGSCHEMA to
# PGUSER, so when the schema is named after the connecting role Postgres' default
# search_path finds it and this can stay unset. `just migrate` targets the schema
# below, which does not match POSTGRES_USER above, so locally it must be set.
POSTGRES_SCHEMA=nannos

# ---------------------------------------------------------------------------
# Installation notification secrets
# ---------------------------------------------------------------------------
# Backend for per-installation A2A notification secrets.
#   db      (default) — persisted via the storage provider; cloud-agnostic, no extra infra.
#   aws-ssm           — AWS SSM Parameter Store (requires AWS credentials).
INSTALLATION_SECRET_PROVIDER=db
# INSTALLATION_SECRET_SSM_PREFIX=/nannos/<env>/client-slack/installation-secrets  # only for aws-ssm

# ---------------------------------------------------------------------------
# AWS (only for AWS-backed providers: S3 file uploads, INSTALLATION_SECRET_PROVIDER=aws-ssm)
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
# Credentials are resolved by the AWS SDK's default chain; set these only to
# override it.
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
FILES_S3_BUCKET=your-files-bucket

# ---------------------------------------------------------------------------
# OIDC
# ---------------------------------------------------------------------------
OIDC_ISSUER_URL=https://your-oidc-issuer.com
OIDC_CLIENT_ID=your-oidc-client-id
# Provide the secret directly via env (cloud-agnostic). Deployments can project
# their secret store (k8s/Docker secrets, Vault, AWS External Secrets, ...) here.
OIDC_CLIENT_SECRET=your-oidc-client-secret
# Opt-in AWS fallback: fetch from SSM when OIDC_CLIENT_SECRET is unset.
# OIDC_CLIENT_SECRET_SSM_KEY=/path/to/ssm/key
OIDC_ORCHESTRATOR_AUDIENCE=orchestrator

# ---------------------------------------------------------------------------
# A2A server
# ---------------------------------------------------------------------------
# Base URL of the orchestrator. The agent card path is resolved relative to it,
# so keep the trailing slash (a path without one loses its last segment).
A2A_SERVER_URL=https://your-a2a-server.com/
A2A_SERVER_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Console backend (optional — enables message feedback)
# ---------------------------------------------------------------------------
# CONSOLE_BACKEND_URL=https://your-console-backend.com
# OIDC_CONSOLE_BACKEND_AUDIENCE=agent-console

# ---------------------------------------------------------------------------
# Admin access and sessions
# ---------------------------------------------------------------------------
# Group granting access to the admin endpoints. Required. Matched against the
# `groups` claim of the OIDC access token, so it is an identity-provider group
# rather than a Slack one.
ADMIN_GROUP=your-admin-group

# Secret used to sign session cookies. Required.
# Generate one with: openssl rand -hex 32
V2_COOKIE_SECRET=your-cookie-secret

# Admin session lifetime in seconds (default 86400)
# SESSION_TTL_SECONDS=86400
